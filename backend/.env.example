# Backend environment variables
# Copy this file to .env and update values for your local environment.

# JWT configuration
JWT_SECRET=replace-with-your-secret
JWT_EXPIRES_IN=1d
JWT_COOKIE_EXPIRED_IN=90

# Database configuration
# Sequelize uses backend/config/config.json by default.
# If you want to use a connection string instead, set USE_ENV_VARIABLE to the key name in config.json.
# Example config.json entry:
# "development": {
#   "use_env_variable": "DATABASE_URL",
#   "dialect": "postgres"
# }
USE_ENV_VARIABLE=
DATABASE_URL=postgres://postgres:4199@127.0.0.1:5432/library
